-- Basic Level

-- 1. Find all employees.

SELECT * FROM employees;

-- 2. Find employees whose salary is greater than ₹50,000.

SELECT * FROM employees
WHERE salary > 50000;

-- 3. Find employees from the IT department.

SELECT * FROM employees
WHERE department ='IT';

-- 4. Find employees whose names start with 'A'.

SELECT * FROM employees
WHERE emp_name LIKE 'A%'

-- 5. Find employees whose names end with 'n'.

SELECT * FROM employees
WHERE emp_name LIKE '%n'

-- 6. Find employees whose names contain 'ra'.

SELECT * FROM employees
WHERE emp_name LIKE '%ra%'

-- 7. Display employees ordered by salary (highest first).

SELECT * FROM employees 
ORDER BY salary DESC

-- 8. Display the top 5 highest-paid employees.

SELECT * FROM employees
ORDER BY salary DESC
LIMIT 5

-- 9. Count the total number of employees.

SELECT COUNT(*) AS total_emp FROM employees

-- 10. Find the average salary.

SELECT AVG(salary) AS avg_salary FROM employees

-- Intermediate Level

-- 11. Find the highest salary.

SELECT * FROM employees
ORDER BY salary DESC

-- 12. Find the second-highest salary.

SELECT * FROM employees
ORDER BY salary DESC
LIMIT 1 OFFSET 1

-- 13. Find the third-highest salary.

SELECT * FROM employees
ORDER BY salary DESC
LIMIT 1 OFFSET 2

-- 14. Find the nth highest salary.

SELECT * FROM employees
ORDER BY salary DESC
LIMIT 1 OFFSET 

-- 15. Find the lowest salary.

SELECT * FROM employees
ORDER BY salary ASC

-- 16. Find the second-lowest salary.

SELECT * FROM employees
ORDER BY salary ASC
LIMIT 1 OFFSET 1

-- 17. Find employees earning more than the average salary.

-- SELECT AVG(*) AS avg_salary 
-- FROM employees
-- HAVING avg_salary > 60000

SELECT *
FROM employees
WHERE salary > (
	SELECT AVG(salary)
	FROM employees
) 

-- 18. Find employees earning less than the average salary.

SELECT *
FROM employees
WHERE salary < (
	SELECT AVG(salary) 
	FROM employees
)

-- 19. Find employees with the same salary.

SELECT salary, COUNT(*) AS employee_count
FROM employees
GROUP BY salary 
HAVING COUNT(*) > 2

-- 20. Find duplicate employee names.

SELECT salary, COUNT(*) AS employee_count
FROM employees
GROUP BY emp_name
HAVING COUNT(*) > 2